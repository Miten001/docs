# Facebook Finance Auto-Poster — environment configuration
# Copy this file to `.env` and fill in your own values.
# ALL services used are FREE. Total monthly cost: $0.

# ---- Required ----

# Facebook Page ID (free) — the numeric ID of the page you manage.
FB_PAGE_ID=

# Long-lived Facebook Page Access Token (free from https://developers.facebook.com).
# Must have permissions: pages_manage_posts, pages_read_engagement
FB_ACCESS_TOKEN=

# Google Gemini API key (FREE from https://aistudio.google.com).
# Free tier: 15 requests/minute, 1M tokens/day.
GEMINI_API_KEY=

# ---- Optional ----

# Groq API key (FREE from https://console.groq.com) — used as a fallback
# when Gemini is rate-limited. Leave blank to disable Groq fallback.
GROQ_API_KEY=

# Default number of posts per day (1-15). Default: 10
POSTS_PER_DAY=10

# Directory where generated images and the manifest are written. Default: ./output
OUTPUT_DIR=./output

# Target timezone for scheduling. Default: America/New_York
TIMEZONE=America/New_York

# NOTE: Pollinations.ai (image generation) requires NO API key — it is completely free.
